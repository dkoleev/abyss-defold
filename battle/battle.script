local model = require("scr.battle")
local MN = require("scr.const.message_names")


function init(self)
	msg.post(".", MN.acquire_input_focus)

	-- model.init()
	self.model = model.new()
	self.model:start()
end

function on_input(self, action_id, action)
	self.model:on_input(action_id, action)
end

function on_message(self, message_id, message, sender)
	self.model:on_message(message_id, message, sender)
	-- model.on_message(message_id, message, sender)
end


