local model = require("scr.battle")
local MN = require("scr.const.message_names")
local tweener = require("tweener.tweener")

local BUMP_SCALE = vmath.vector3(1.25, 1.25, 1)
local NORMAL_SCALE = vmath.vector3(1, 1, 1)
local BUMP_DURATION = 0.15
local SETTLE_DURATION = 0.2
local COUNT_DURATION = 0.2

local function set_player_damage(self, value)
	go.cancel_animations(self.player_damage_label_url, "scale")
	self.count_from = self.displayed_damage or 0
	self.count_to = nil
	label.set_text(self.player_damage_label_url, tostring(value))
end

local function set_player_damage_anim(self, value)
	local label_url = self.player_damage_label_url
	local from_value = self.displayed_damage or 0
	self.displayed_damage = value

	-- cancel any in-flight tween/animation so rapid updates don't conflict
	tweener.cancel(self.count_tween)
	go.cancel_animations(label_url, "scale")

	-- bump: punch up, then settle back with overshoot easing
	-- go.set(label_url, "scale", NORMAL_SCALE)
	-- go.animate(label_url, "scale", go.PLAYBACK_ONCE_FORWARD, BUMP_SCALE, go.EASING_OUTBACK, BUMP_DURATION, 0, function()
	-- 	go.animate(label_url, "scale", go.PLAYBACK_ONCE_FORWARD, NORMAL_SCALE, go.EASING_OUTQUAD, SETTLE_DURATION)
	-- end)

	-- count-up: tweener handles the per-frame updates internally, no need for `update()`
	-- self.count_tween = tweener.tween(tweener.outquad, from_value, value, COUNT_DURATION, function(v)
	-- 	label.set_text(label_url, tostring(math.floor(v + 0.5)))
	-- end)

	self.count_tween = tweener.tween(gui.EASING_OUTCIRC, from_value, value, COUNT_DURATION,
		function(value, is_final_call)
			label.set_text(label_url, math.floor(value + 0.5))

			if is_final_call then
				go.set(label_url, "scale", BUMP_SCALE)
				go.animate(label_url, "scale", go.PLAYBACK_ONCE_FORWARD, NORMAL_SCALE, go.EASING_OUTBOUNCE, 0.5)
			end
		end)
end

function init(self)
	msg.post(".", MN.acquire_input_focus)

	self.model = model.new()
	self.model:start()

	self.player_damage_label_url = msg.url("/damage_root#player_damage_text")
	self.displayed_damage = 0
	self.count_anim_value = 0

	label.set_text(self.player_damage_label_url, "0")
end

function on_input(self, action_id, action)
	self.model:on_input(action_id, action)
end

function on_message(self, message_id, message, sender)
	if message_id == MN.player_damage_changed then
		if message.with_animation then
			set_player_damage_anim(self, message.value)
		else
			set_player_damage(self, message.value)
		end
	end

	self.model:on_message(message_id, message, sender)
end

function final(self)
	tweener.cancel(self.count_tween)
end
