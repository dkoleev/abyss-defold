function init(self)
    self.druid = druid.new(self)

    -- self.progress = self.druid:new_progress("damned_progress_fill", "x")

    self.current_value = 1.0
    self.full_width = gui.get_size(gui.get_node("damned_progress_clip")).x
    self.clip_front = gui.get_node("damned_progress_clip")
    self.clip_back = gui.get_node("damned_progress_clip_back")

    set_progress(self, self.current_value, true) -- start full
end

function final(self)
    self.druid:final()
end

function update(self, dt)
    self.druid:update(dt)
end

function on_message(self, message_id, message, sender)
    self.druid:on_message(message_id, message, sender)

    if message_id == MN.set_progress then
        set_progress(self, message.value, message.duration == nil)
        -- set_progress(self, message.value)
        -- animate_progress(self, message.value, message.duration)

        -- if message.duration then
        --     self.progress:to(message.value, message.duration)
        -- else
        -- self.progress:set_to(message.value)
        -- end
    end
end

function on_input(self, action_id, action)
    return self.druid:on_input(action_id, action)
end
