local druid = require("druid.druid")
local MN = require("scr.const.message_names")

local LERP_DELAY = 0.4     -- pause before back layer starts moving
local BACK_DURATION = 0.6  -- slow drain duration
local FRONT_DURATION = 0.1 -- fast snap duration

local function resize(node, width)
    local size = gui.get_size(node)
    size.x = width
    gui.set_size(node, size)
end

local function set_progress(self, value, skip_animation)
    value = math.max(0, math.min(1, value))
    local old_value = self.current_value
    self.current_value = value

    local target_width = self.full_width * value

    if skip_animation then
        resize(self.clip_front, target_width)
        resize(self.clip_back, target_width)
        return
    end

    if value < old_value then
        -- LOSING fill: front snaps fast, back lags behind then drains
        gui.animate(self.clip_front, gui.PROP_SIZE,
            vmath.vector3(target_width, gui.get_size(self.clip_front).y, 0),
            gui.EASING_OUTQUAD, FRONT_DURATION)

        -- back waits, then slowly drains down to match
        timer.delay(LERP_DELAY, false, function()
            gui.animate(self.clip_back, gui.PROP_SIZE,
                vmath.vector3(target_width, gui.get_size(self.clip_back).y, 0),
                gui.EASING_INOUTQUAD, BACK_DURATION)
        end)
    else
        -- GAINING fill: snap both up together (or animate front, snap back)
        gui.animate(self.clip_front, gui.PROP_SIZE,
            vmath.vector3(target_width, gui.get_size(self.clip_front).y, 0),
            gui.EASING_OUTQUAD, FRONT_DURATION)
        resize(self.clip_back, target_width)
    end
end

