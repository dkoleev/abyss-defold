local message_names = require("scr.const.message_names")

function on_message(self, message_id, message, sender)
	if message_id == message_names.dead then
		go.delete()
	end

	if message_id == message_names.take_damage then
		go.animate(".",
			"scale",
			go.PLAYBACK_ONCE_PINGPONG,
			vmath.vector3(0.5), go.EASING_INBACK, 0.5)
	end
end
