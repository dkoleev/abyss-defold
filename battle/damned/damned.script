local global_urls   = require("scr.const.global_urls")
local message_names = require("scr.const.message_names")
local log           = require("log.log")

function init(self)
	self.battle_url = global_urls.battle()
	log:debug("Spawn damend: " .. msg.url())
end

function on_message(self, message_id, message, sender)
	if message_id == message_names.dead then
		go.delete()
	end

	if message_id == message_names.take_damage then
		go.animate(".",
			"scale",
			go.PLAYBACK_ONCE_PINGPONG,
			vmath.vector3(0.5), go.EASING_INBACK, 0.5)
	end

	if message_id == message_names.attack then
		local attack_duration = 0.5
		local attack_damage_phase = attack_duration / 2

		timer.delay(attack_damage_phase, false, function()
			msg.post(self.battle_url, message_names.damned_attack_apply)
		end)

		go.animate(".",
			"scale",
			go.PLAYBACK_ONCE_PINGPONG,
			vmath.vector3(1.5), go.EASING_INBACK, attack_duration, 0, function()
				msg.post(self.battle_url, message_names.damned_attack_finished)
			end)
	end
end
