local MN              = require("scr.const.message_names")
local visual_settings = require("scr.settings.visual_settings")
local settings        = require("scr.settings.game_settings")
local global_urls     = require("scr.const.global_urls")

local function get_max_y(slots)
    local max_y = -math.huge
    for _, s in ipairs(slots) do
        if s.y > max_y then max_y = s.y end
    end
    return max_y
end

local function random_symbol()
    local pool = settings.symbols_spawn_pool
    return pool[math.random(#pool)]
end

local function setup_reel(self)
    local symbol_1 = go.get_id("symbol_1")
    local symbol_2 = go.get_id("symbol_2")
    local symbol_3 = go.get_id("symbol_3")

    local symbols = { symbol_1, symbol_2, symbol_3 }
    local count = #symbols

    for i, id in ipairs(symbols) do
        local y = (count - i) * visual_settings.slots.symbol_size
        local url = msg.url(nil, id, nil)

        self.slots[i] = {
            url        = url,
            sprite_url = msg.url(nil, id, "sprite"), -- reuse child_id
            y          = y,
            symbol     = random_symbol(),
        }
        go.set_position(vmath.vector3(0, y, 0), url)
        sprite.play_flipbook(self.slots[i].sprite_url, hash(self.slots[i].symbol.icon))
    end
end

function init(self)
    self.spinning   = false
    self.locked     = false
    self.result     = nil
    self.slots      = {}
    self.battle_url = global_urls.battle()

    setup_reel(self)
end

function update(self, dt)
    if not self.spinning or self.locked then return end

    local bottom_edge = -visual_settings.slots.symbol_size

    for _, slot in ipairs(self.slots) do
        slot.y = slot.y - visual_settings.slots.scroll_speed * dt

        if slot.y < bottom_edge then
            slot.y      = get_max_y(self.slots) + visual_settings.slots.symbol_size
            slot.symbol = random_symbol()
            sprite.play_flipbook(slot.sprite_url, hash(slot.symbol.icon))
        end

        go.set_position(vmath.vector3(0, slot.y, 0), slot.url)
    end
end

function on_message(self, message_id, message)
    if message_id == MN.start_spin then
        self.spinning = true
        self.locked   = false
        self.result   = nil
    elseif message_id == MN.stop_reel then
        if not self.spinning or self.locked then return end
        self.locked = true

        -- find slot closest to y=0 (result window)
        -- local best_slot, best_dist = self.slots[1], math.huge
        local best_slot, best_dist = nil, math.huge
        for _, slot in ipairs(self.slots) do
            local dist = math.abs(slot.y)
            if dist < best_dist then
                best_dist = dist
                best_slot = slot
            end
        end

        -- snap all slots so best_slot lands exactly at y=0
        local offset = best_slot.y
        for _, slot in ipairs(self.slots) do
            slot.y = slot.y - offset
            go.set_position(vmath.vector3(0, slot.y, 0), slot.url)
        end

        self.result = best_slot.symbol

        msg.post(self.battle_url, MN.reel_stopped, {
            reel_index = message.reel_index,
            symbol     = self.result,
        })
    end
end
