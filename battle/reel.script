local symbol_db  = require("scr.symbol_db")
local MN         = require("scr.const.message_names")

local SYMBOL_H   = 32  -- px per symbol cell
local SCROLL_SPD = 100 -- px/sec

local CHILD_IDS  = { "symbol_1", "symbol_2", "symbol_3" }
local COUNT      = #CHILD_IDS

local function get_max_y(slots)
    local max_y = -math.huge
    for _, s in ipairs(slots) do
        if s.y > max_y then max_y = s.y end
    end
    return max_y
end

local function random_symbol()
    local pool = symbol_db.player_pool
    return pool[math.random(#pool)]
end

function init(self)
    self.spinning = false
    self.locked   = false
    self.result   = nil
    self.slots    = {}

    for i, id in ipairs(CHILD_IDS) do
        local y = (COUNT - i) * SYMBOL_H
        local url = msg.url(nil, go.get_id(id), nil)
        self.slots[i] = {
            url        = url,
            sprite_url = msg.url(nil, go.get_id(id), hash("sprite")),
            y          = y,
            symbol     = random_symbol(),
        }
        go.set_position(vmath.vector3(0, y, 0), url)
    end
end

function update(self, dt)
    if not self.spinning or self.locked then return end

    local bottom_edge = -SYMBOL_H

    for _, slot in ipairs(self.slots) do
        slot.y = slot.y - SCROLL_SPD * dt

        if slot.y < bottom_edge then
            slot.y      = get_max_y(self.slots) + SYMBOL_H
            slot.symbol = random_symbol()
            sprite.play_flipbook(slot.sprite_url, hash(slot.symbol.icon))
        end

        go.set_position(vmath.vector3(0, slot.y, 0), slot.url)
    end
end

function on_message(self, message_id, message)
    if message_id == MN.start_spin then
        self.spinning = true
        self.locked   = false
        self.result   = nil
    elseif message_id == MN.stop_reel then
        if not self.spinning or self.locked then return end
        self.locked = true

        -- find slot closest to y=0 (result window)
        local best_slot, best_dist = nil, math.huge
        for _, slot in ipairs(self.slots) do
            local dist = math.abs(slot.y)
            if dist < best_dist then
                best_dist = dist
                best_slot = slot
            end
        end

        -- snap all slots so best_slot lands exactly at y=0
        local offset = best_slot.y
        for _, slot in ipairs(self.slots) do
            slot.y = slot.y - offset
            go.set_position(vmath.vector3(0, slot.y, 0), slot.url)
        end

        self.result = best_slot.symbol

        msg.post(message.reply_to, MN.reel_stopped, {
            reel_index = message.reel_index,
            symbol     = self.result,
        })
    end
end
