local slot_machine_logic = require("scr.slot_machine")
local MN = require("scr.const.message_names")
local IN = require("scr.const.input_names")

local REEL_SPACING = 40 -- px between reels

local function apply_effects(self, effects)
	for _, fx in ipairs(effects) do
		if fx.type == "attack" then
			msg.post("enemy#brain", "take_damage", { amount = fx.value })
		elseif fx.type == "defend" then
			msg.post("player#stats", "add_block", { amount = fx.value })
		elseif fx.type == "heal" then
			msg.post("player#stats", "heal", { amount = fx.value })
		elseif fx.type == "gold" then
			msg.post("game_manager#script", "add_gold", { amount = fx.value })
		end

		-- triple bonus visual feedback
		if fx.is_triple then
			msg.post("ui#hud", "show_triple_bonus", { symbol = fx.symbol.id })
		end
	end

	-- after effects resolve, enemy takes its turn
	msg.post("enemy#brain", "enemy_turn")
end

function init(self)
	msg.post(".", MN.acquire_input_focus)

	self.reel_urls = {}

	local pos = go.get_position(".")
	local reels_count = 3
	local start_offset_x = -REEL_SPACING * (reels_count - 1) / 2

	for i = 1, reels_count do
		local x           = (i - 1) * REEL_SPACING
		local spawn_pos = vmath.vector3(pos.x + x + start_offset_x, pos.y, pos.z - 0.1) -- position each reel 
		local ids         = collectionfactory.create(
			"#reel_collectionfactory",
			spawn_pos
		)

		-- collectionfactory.create returns a table { [hashed_id] = hashed_id }
		-- find the root GO of spawned collection by its id suffix
		local root_id     = ids[hash("/root")]
		self.reel_urls[i] = msg.url(nil, root_id, "reel")
	end

	self.model = slot_machine_logic.new(self.reel_urls)
	self.model.on_spin_done = function(effects)
		apply_effects(self, effects)
	end
	self.current_stop = 1 -- which reel player stops next

	slot_machine_logic.spin(self.model)
end

function on_input(self, action_id, action)
	-- any tap / Space stops the next unlocked reel in order
	if action_id == IN.STOP_REEL and action.pressed then
		if self.model.spinning and self.current_stop <= #self.reel_urls then
			msg.post(self.reel_urls[self.current_stop], MN.stop_reel, {
				reel_index = self.current_stop,
				reply_to   = msg.url(),
			})
			self.current_stop = self.current_stop + 1
		end
	end
end

function on_message(self, message_id, message)
	if message_id == MN.reel_stopped then
		slot_machine_logic.on_reel_stopped(self.model, message)
	end
end
