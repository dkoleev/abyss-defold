end

function on_message(self, message_id, message, sender)
    if message_id == hash("change_rotation") then
        self.base_rot = message.rotation
    end

    if message_id == hash("juice_up") then
        -- optional custom scale/rot from message data
        anim_logic.juice_up(self, message.scale, message.rot)
    end
end
