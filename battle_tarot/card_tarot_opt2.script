local movable  = require("scr.card.card_move")
local MN       = require("scr.const.message_names")
local settings = require("scr.settings.game_settings")

go.property("card_id", hash(""))

--[[
  States:
    IDLE      - card is sitting in the hand fan, idle sway active
    HOVERING  - cursor is over the card, card lifted
    HOLDING   - mouse button held down on the card
    SELECTED  - card has been committed to "selected" pile
    DISCARDING- flying off screen
]]

local STATE = {
	IDLE       = "IDLE",
	HOVERING   = "HOVERING",
	HOLDING    = "HOLDING",
	SELECTED   = "SELECTED",
	DISCARDING = "DISCARDING",
}

function init(self)
	msg.post(".", MN.acquire_input_focus)

	-- Find the matching card data using the passed hash
	for key, card in pairs(settings.tarot) do
		if hash(card.id) == self.card_id then
			self.card_config = card
			break
		end
	end

	pprint(self.card_config)

	-- The initial position comes from factory spawn properties (or defaults here)
	local pos       = go.get_position()
	self.base_x     = pos.x -- hand fan x — set by the hand layout system
	self.base_y     = pos.y -- hand fan y
	self.base_z     = pos.z
	self.base_rot   = 0  -- hand fan rotation (set by hand layout)
	self.is_hovered = false
	self.is_held    = false
	self.go_id      = go.get_id()

    self.move = movable.create(self.go_id, pos.x, pos.y, pos.z, self.base_rot, self.card_config.index)

	self.state      = STATE.IDLE
end

function update(self, dt)
	-- Drive the easing loop every frame.
	-- card_move.update does nothing if stationary (cheap path).
	movable.update(self.move, dt)
end

function on_message(self, message_id, message, sender)
    if message_id == MN.change_rotation then
        self.base_rot = message.rotation
		movable.hard_set_rot(self.move, self.base_rot)
    end
end


function final(self)
	msg.post(".", MN.release_input_focus)
end

