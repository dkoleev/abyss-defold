[bootstrap]
main_collection = /bootstrap/bootstrap.collectionc

[script]
shared_state = 1

[display]
width = 720
height = 1280
high_dpi = 1
fullscreen = 0
vsync = 1
display_device_info = 0

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[project]
title = abyss
write_log_file = 1
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/heads/main.zip
dependencies#1 = https://github.com/britzl/defold-orthographic/archive/refs/tags/3.6.2.zip
dependencies#2 = https://github.com/Insality/druid/archive/refs/tags/1.2.3.zip
dependencies#3 = https://github.com/Insality/defold-log/archive/refs/tags/6.zip
dependencies#4 = https://github.com/Insality/defold-tweener/archive/refs/tags/6.zip
dependencies#5 = https://github.com/subsoap/defos/archive/refs/tags/v2.8.7.zip
dependencies#6 = https://github.com/Insality/defold-event/archive/refs/tags/16.zip

[sprite]
subpixels = 0
max_count = 256

[graphics]
default_texture_min_filter = nearest
default_texture_mag_filter = nearest

